# -----------------------------------------------------------------------------
# Workforce ERP — ports & service connections
# -----------------------------------------------------------------------------
# Local development port ownership. Keep these unique so `pnpm dev` apps do not
# silently move to another port.
DEV_HOST=localhost
WEB_DEV_PORT=5173
ERP_DEV_PORT=5174
ADMIN_DEV_PORT=5175
WEB_BASE_PATH=/
ERP_BASE_PATH=/erp/
ADMIN_BASE_PATH=/admin/
WEB_PREVIEW_PORT=4173
ERP_PREVIEW_PORT=4174
ADMIN_PREVIEW_PORT=4175

# Browser API contract
#
# Local development uses same-origin URLs and Vite proxies `/api` + `/sanctum`
# to VITE_API_PROXY_TARGET. This is the preferred setup for Laravel Sanctum.
#
# For a cross-origin production deployment, set both values explicitly, e.g.:
# VITE_API_BASE_URL=https://api.example.com
# VITE_API_URL=https://api.example.com/api
VITE_API_BASE_URL=
VITE_API_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Public application origins used for cross-app navigation and metadata.
VITE_WEB_URL=http://localhost:5173
VITE_ERP_URL=http://localhost:5173/erp/
VITE_ADMIN_URL=http://localhost:5173/admin/

# Realtime notifications (optional)
#
# Leave these commented out and the ERP notification bell refreshes by polling.
# Fill them in once the API broadcasts over Reverb or Pusher and the same bell
# switches to live websocket updates with no code change.
#
# Local Reverb defaults (`php artisan reverb:start`):
# VITE_REVERB_APP_KEY=your-app-key
# VITE_REVERB_HOST=localhost
# VITE_REVERB_PORT=8080
# VITE_REVERB_SCHEME=http
#
# Pusher alternative:
# VITE_PUSHER_APP_KEY=
# VITE_PUSHER_HOST=
# VITE_PUSHER_PORT=443
# VITE_PUSHER_SCHEME=https
# VITE_PUSHER_APP_CLUSTER=mt1

# E2E
E2E_WEB_URL=http://localhost:5173
E2E_ERP_URL=http://localhost:5173/erp/
E2E_ADMIN_URL=http://localhost:5173/admin/
E2E_API_URL=http://localhost:8000/api
