# -----------------------------------------------------------------------------
# Workforce ERP — ports & service connections
# -----------------------------------------------------------------------------
# Local development port ownership. Keep these unique so `pnpm dev` apps do not
# silently move to another port.
DEV_HOST=localhost
WEB_DEV_PORT=5173
ERP_DEV_PORT=5174
ADMIN_DEV_PORT=5175
WEB_PREVIEW_PORT=4173
ERP_PREVIEW_PORT=4174
ADMIN_PREVIEW_PORT=4175

# Browser API contract
#
# Local development uses same-origin URLs and Vite proxies `/api` + `/sanctum`
# to VITE_API_PROXY_TARGET. This is the preferred setup for Laravel Sanctum.
#
# For a cross-origin production deployment, set both values explicitly, e.g.:
# VITE_API_BASE_URL=https://api.example.com
# VITE_API_URL=https://api.example.com/api
VITE_API_BASE_URL=
VITE_API_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Public application origins used for cross-app navigation and metadata.
VITE_WEB_URL=http://localhost:5173
VITE_ERP_URL=http://localhost:5174
VITE_ADMIN_URL=http://localhost:5175

# Server-to-server worker connection. Unlike browser URLs, this must be an
# absolute URL because the worker does not run behind the Vite proxy.
API_URL=http://127.0.0.1:8000/api
WORKER_ENABLED=false
# Machine authentication uses a tenant-bound service account. Create/rotate the
# credential in the Security API/UI, then inject it through secret management.
WORKER_SERVICE_CLIENT_ID=
WORKER_SERVICE_CLIENT_SECRET=
WORKER_SERVICE_AUDIENCE=workforce-api
# Required only when WORKER_ENABLED=true. Example: v1/worker/jobs
WORKER_JOBS_PATH=
WORKER_POLL_INTERVAL_MS=15000

# Docker host bindings. Containers still listen on port 80 internally.
WEB_PORT=5173
ERP_PORT=5174
ADMIN_PORT=5175
# Docker/public browser URLs are deliberately separate from Vite dev proxy vars.
# Change these to HTTPS deployment URLs in staging/production.
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_ERP_URL=http://localhost:5174
PUBLIC_ADMIN_URL=http://localhost:5175
PUBLIC_API_BASE_URL=http://localhost:8000
PUBLIC_API_URL=http://localhost:8000/api

# Worker -> API URL as seen from inside Docker.
WORKER_API_URL=http://host.docker.internal:8000/api

# E2E
E2E_WEB_URL=http://localhost:5173
E2E_ERP_URL=http://localhost:5174
E2E_ADMIN_URL=http://localhost:5175
E2E_API_URL=http://localhost:8000/api
