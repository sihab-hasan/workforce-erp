{
  "name": "workforce-erp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "nx": "nx",
    "dev": "nx run-many -t dev --exclude=@workforce-erp/api --parallel=4",
    "dev:web": "nx dev @workforce-erp/web",
    "dev:erp": "nx dev @workforce-erp/erp",
    "dev:admin": "nx dev @workforce-erp/admin",
    "dev:api": "nx run @workforce-erp/api:serve",
    "build": "nx run-many -t build --exclude=@workforce-erp/api",
    "lint": "nx run-many -t lint --exclude=@workforce-erp/api",
    "typecheck": "nx run-many -t typecheck --exclude=@workforce-erp/api",
    "check": "pnpm typecheck && pnpm lint && pnpm build",
    "check:api": "nx run @workforce-erp/api:check",
    "test:api": "nx run @workforce-erp/api:test",
    "lint:api": "nx run @workforce-erp/api:lint",
    "affected:check": "nx affected -t typecheck lint build --exclude=@workforce-erp/api",
    "graph": "nx graph",
    "show:projects": "nx show projects",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "reset": "nx reset",
    "shadcn": "pnpm dlx shadcn@latest",
    "ui:add": "pnpm dlx shadcn@latest add --cwd apps/erp",
    "ui:add:all": "pnpm dlx shadcn@latest add --all --yes --cwd apps/erp",
    "docker:build": "docker compose --env-file .env.docker -f infra/compose.yaml up -d --build",
    "docker:up": "docker compose --env-file .env.docker -f infra/compose.yaml up -d",
    "docker:down": "docker compose --env-file .env.docker -f infra/compose.yaml down",
    "docker:ps": "docker compose --env-file .env.docker -f infra/compose.yaml ps",
    "docker:logs:api": "docker compose --env-file .env.docker -f infra/compose.yaml logs -f api",
    "docker:logs:caddy": "docker compose --env-file .env.docker -f infra/compose.yaml logs -f caddy",
    "docker:logs:queue": "docker compose --env-file .env.docker -f infra/compose.yaml logs -f queue",
    "docker:artisan": "docker compose --env-file .env.docker -f infra/compose.yaml exec api php artisan",
    "test": "pnpm test:api"
  },
  "devDependencies": {
    "@workforce-erp/eslint-config": "workspace:*",
    "@workforce-erp/prettier-config": "workspace:*",
    "@workforce-erp/typescript-config": "workspace:*",
    "eslint": "^9.33.0",
    "nx": "^23.1.1",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2"
  }
}
