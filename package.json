{
  "name": "workforce-erp",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "turbo build",
    "clean": "powershell -ExecutionPolicy Bypass -File ./infra/scripts/clean.ps1",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:packages": "turbo format",
    "setup": "powershell -ExecutionPolicy Bypass -File ./infra/scripts/setup.ps1",
    "stop": "powershell -ExecutionPolicy Bypass -File ./infra/scripts/stop.ps1",
    "typecheck": "turbo typecheck",
    "validate": "pnpm format && pnpm format:check && pnpm lint && pnpm typecheck && pnpm build"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.18",
    "typescript": "~6"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  }
}
