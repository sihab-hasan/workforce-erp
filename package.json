{
  "name": "workforce-erp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "nx": "nx",
    "dev": "nx run-many -t dev --exclude=@workforce-erp/api --parallel=4",
    "dev:web": "nx dev @workforce-erp/web",
    "dev:erp": "nx dev @workforce-erp/erp",
    "dev:admin": "nx dev @workforce-erp/admin",
    "dev:worker": "nx dev @workforce-erp/worker",
    "dev:api": "nx run @workforce-erp/api:serve",
    "build": "nx run-many -t build --exclude=@workforce-erp/api",
    "lint": "nx run-many -t lint --exclude=@workforce-erp/api",
    "typecheck": "nx run-many -t typecheck --exclude=@workforce-erp/api",
    "check": "pnpm validate && pnpm check:imports && pnpm typecheck && pnpm lint && pnpm build",
    "check:api": "nx run @workforce-erp/api:check",
    "test:api": "nx run @workforce-erp/api:test",
    "lint:api": "nx run @workforce-erp/api:lint",
    "affected:check": "nx affected -t typecheck lint build --exclude=@workforce-erp/api",
    "graph": "nx graph",
    "show:projects": "nx show projects",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "node scripts/validate.mjs",
    "clean": "node scripts/clean.mjs",
    "reset": "nx reset",
    "shadcn": "pnpm dlx shadcn@latest",
    "ui:add": "pnpm dlx shadcn@latest add --cwd apps/erp",
    "ui:add:all": "pnpm dlx shadcn@latest add --all --yes --cwd apps/erp",
    "check:imports": "node tooling/check-imports.mjs",
    "connections:check": "node scripts/validate.mjs",
    "docker:setup": "node scripts/docker-setup.mjs",
    "docker:up": "node scripts/docker-setup.mjs && docker compose --env-file .env.docker -f infra/docker-compose.yml up -d",
    "docker:build": "node scripts/docker-setup.mjs && docker compose --env-file .env.docker -f infra/docker-compose.yml up -d --build",
    "docker:down": "docker compose --env-file .env.docker -f infra/docker-compose.yml down",
    "docker:restart": "docker compose --env-file .env.docker -f infra/docker-compose.yml restart",
    "docker:ps": "docker compose --env-file .env.docker -f infra/docker-compose.yml ps",
    "docker:logs": "docker compose --env-file .env.docker -f infra/docker-compose.yml logs -f",
    "docker:logs:api": "docker compose --env-file .env.docker -f infra/docker-compose.yml logs -f api",
    "docker:logs:nginx": "docker compose --env-file .env.docker -f infra/docker-compose.yml logs -f nginx",
    "docker:logs:queue": "docker compose --env-file .env.docker -f infra/docker-compose.yml logs -f queue",
    "docker:rebuild": "docker compose --env-file .env.docker -f infra/docker-compose.yml down && docker compose --env-file .env.docker -f infra/docker-compose.yml up -d --build",
    "docker:pull": "docker compose --env-file .env.docker -f infra/docker-compose.yml pull",
    "docker:config": "docker compose --env-file .env.docker -f infra/docker-compose.yml config",
    "docker:shell:api": "docker compose --env-file .env.docker -f infra/docker-compose.yml exec api sh",
    "docker:artisan": "docker compose --env-file .env.docker -f infra/docker-compose.yml exec api php artisan",
    "docker:migrate": "docker compose --env-file .env.docker -f infra/docker-compose.yml exec api php artisan migrate --force",
    "docker:optimize": "docker compose --env-file .env.docker -f infra/docker-compose.yml exec api php artisan optimize",
    "docker:clear": "docker compose --env-file .env.docker -f infra/docker-compose.yml exec api php artisan optimize:clear",
    "docker:cert:init": "bash scripts/docker-certbot.sh init",
    "docker:cert:renew": "bash scripts/docker-certbot.sh renew",
    "security:source": "python3 scripts/security-source-check.py",
    "security:release": "bash scripts/security-release-check.sh",
    "test:frontend": "node --test tests/frontend/*.test.mjs",
    "test": "pnpm test:frontend && pnpm test:api"
  },
  "devDependencies": {
    "@workforce-erp/eslint-config": "workspace:*",
    "@workforce-erp/prettier-config": "workspace:*",
    "@workforce-erp/typescript-config": "workspace:*",
    "eslint": "^9.33.0",
    "nx": "^23.1.1",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2"
  }
}
