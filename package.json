{
  "name": "workforce-erp",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "turbo build",
    "clean": "powershell -ExecutionPolicy Bypass -File ./infra/scripts/clean.ps1",
    "predev": "powershell -ExecutionPolicy Bypass -File ./infra/scripts/predev.ps1",
    "dev": "turbo dev",
    "docker:up": "docker compose -f infra/compose/compose.yml -f infra/compose/compose.local.yml up -d --build",
    "docker:down": "docker compose -f infra/compose/compose.yml -f infra/compose/compose.local.yml down --remove-orphans",
    "docker:ps": "docker compose -f infra/compose/compose.yml -f infra/compose/compose.local.yml ps",
    "docker:logs": "docker compose -f infra/compose/compose.yml -f infra/compose/compose.local.yml logs -f",
    "docker:staging:config": "docker compose -f infra/compose/compose.yml -f infra/compose/compose.staging.yml config",
    "docker:staging:up": "docker compose -f infra/compose/compose.yml -f infra/compose/compose.staging.yml up -d",
    "docker:staging:down": "docker compose -f infra/compose/compose.yml -f infra/compose/compose.staging.yml down --remove-orphans",
    "docker:production:config": "docker compose -f infra/compose/compose.yml -f infra/compose/compose.production.yml config",
    "docker:production:migrate": "docker compose -f infra/compose/compose.yml -f infra/compose/compose.production.yml run --rm migrate",
    "docker:production:up": "docker compose -f infra/compose/compose.yml -f infra/compose/compose.production.yml up -d",
    "docker:production:down": "docker compose -f infra/compose/compose.yml -f infra/compose/compose.production.yml down --remove-orphans",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:packages": "turbo format",
    "setup": "powershell -ExecutionPolicy Bypass -File ./infra/scripts/setup.ps1",
    "stop": "powershell -ExecutionPolicy Bypass -File ./infra/scripts/stop.ps1",
    "typecheck": "turbo typecheck",
    "validate": "pnpm format && pnpm format:check && pnpm lint && pnpm typecheck && pnpm build"
  },
  "devDependencies": {
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.5",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  }
}
