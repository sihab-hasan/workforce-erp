# Local Docker Desktop stack only. Replace secrets before using outside local development.
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8080
APP_HTTP_PORT=8080

VITE_API_BASE_URL=
VITE_API_URL=/api
VITE_WEB_URL=http://localhost:8080
VITE_ERP_URL=http://localhost:8080/erp/
VITE_ADMIN_URL=http://localhost:8080/admin/

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=workforce_erp
DB_USERNAME=workforce
DB_PASSWORD=workforce-local-only
MYSQL_ROOT_PASSWORD=workforce-root-local-only

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=workforce-redis-local-only
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080
TRUSTED_HOSTS=localhost,127.0.0.1
PORTAL_URL=http://localhost:8080/erp/

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@workforce-erp.local
MAIL_FROM_NAME="Workforce ERP"