# =============================================================================
# Workforce ERP - Docker / Nginx environment
# Copy with: bash scripts/docker-setup.sh
# =============================================================================

# Compose profiles. Leave blank for normal HTTP/local usage.
# The TLS setup script changes this to: tls
COMPOSE_PROFILES=

# -----------------------------------------------------------------------------
# Public hosts / ports
# -----------------------------------------------------------------------------
HTTP_PORT=80
HTTPS_PORT=443
WEB_HOST=web.localhost
ERP_HOST=erp.localhost
ADMIN_HOST=admin.localhost
API_HOST=api.localhost
NGINX_CLIENT_MAX_BODY_SIZE=25m

PUBLIC_WEB_URL=http://web.localhost
PUBLIC_ERP_URL=http://erp.localhost
PUBLIC_ADMIN_URL=http://admin.localhost

# Frontends call Laravel through the same public origin (/api and /sanctum),
# and the gateway proxies those paths to the API. This avoids cross-origin
# Sanctum/CSRF issues and is the recommended Docker layout.
PUBLIC_API_BASE_URL=
PUBLIC_API_URL=/api

# -----------------------------------------------------------------------------
# Laravel API
# -----------------------------------------------------------------------------
APP_NAME="Workforce ERP API"
APP_ENV=production
APP_KEY=__GENERATE_APP_KEY__
APP_DEBUG=false
APP_URL=http://api.localhost
TRUSTED_HOSTS=web.localhost,erp.localhost,admin.localhost,api.localhost,api-nginx,localhost

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=workforce_erp
DB_USERNAME=workforce
DB_PASSWORD=__GENERATE_DB_PASSWORD__

MYSQL_DATABASE=workforce_erp
MYSQL_USER=workforce
MYSQL_PASSWORD=__GENERATE_DB_PASSWORD__
MYSQL_ROOT_PASSWORD=__GENERATE_MYSQL_ROOT_PASSWORD__

CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_DOMAIN=
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=__GENERATE_REDIS_PASSWORD__
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE=default

# These are still useful if a browser ever calls API_HOST directly.
SANCTUM_STATEFUL_DOMAINS=web.localhost,erp.localhost,admin.localhost,api.localhost
CORS_ALLOWED_ORIGINS=http://web.localhost,http://erp.localhost,http://admin.localhost,http://api.localhost
SANCTUM_TOKEN_EXPIRATION=480
SANCTUM_TOKEN_PREFIX=workforce_

API_SHARED_TOKEN=__GENERATE_API_SHARED_TOKEN__
API_SHARED_TOKEN_HEADER=X-API-TOKEN

PORTAL_URL=http://erp.localhost/portal
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://erp.localhost/auth/callback/google
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://erp.localhost/auth/callback/microsoft

MAIL_MAILER=log
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=noreply@workforce.local
MAIL_FROM_NAME="Workforce ERP"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Optional local database seeding. Keep false in production.
LOCAL_BOOTSTRAP_ENABLED=false
LOCAL_BOOTSTRAP_ORGANIZATION_NAME="Workforce Local"
LOCAL_BOOTSTRAP_ORGANIZATION_SLUG=workforce-local
LOCAL_BOOTSTRAP_OWNER_NAME="Local Owner"
LOCAL_BOOTSTRAP_OWNER_EMAIL=owner@workforce.local
LOCAL_BOOTSTRAP_OWNER_PASSWORD=

# -----------------------------------------------------------------------------
# Node worker (optional profile: node-worker)
# -----------------------------------------------------------------------------
WORKER_API_URL=http://api-nginx/api
WORKER_ENABLED=false
WORKER_JOBS_PATH=
WORKER_POLL_INTERVAL_MS=15000

# -----------------------------------------------------------------------------
# TLS / Let's Encrypt
# For production: set hosts + PUBLIC_* URLs + APP_URL to your real HTTPS domains,
# set LETSENCRYPT_EMAIL, then run: bash scripts/docker-certbot.sh init
# -----------------------------------------------------------------------------
ENABLE_TLS=false
TLS_CERT_NAME=
LETSENCRYPT_EMAIL=
