FROM node:22-alpine AS build

WORKDIR /repo
COPY . .
RUN corepack enable && pnpm install --frozen-lockfile

ARG VITE_API_BASE_URL=
ARG VITE_API_URL=/api
ARG VITE_WEB_URL=http://localhost:8080
ARG VITE_ERP_URL=http://localhost:8080/erp/
ARG VITE_ADMIN_URL=http://localhost:8080/admin/
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_API_URL=$VITE_API_URL \
    VITE_WEB_URL=$VITE_WEB_URL \
    VITE_ERP_URL=$VITE_ERP_URL \
    VITE_ADMIN_URL=$VITE_ADMIN_URL

RUN VITE_BASE_PATH=/ pnpm nx build @workforce-erp/web \
    && VITE_BASE_PATH=/erp/ pnpm nx build @workforce-erp/erp \
    && VITE_BASE_PATH=/admin/ pnpm nx build @workforce-erp/admin

FROM nginx:alpine
COPY infra/docker/nginx.conf /etc/nginx/conf.d/default.conf

# Copy frontend distributions matching the root directory tree
COPY --from=build /repo/apps/web/dist/ /usr/share/nginx/html/
COPY --from=build /repo/apps/erp/dist/ /usr/share/nginx/html/erp/
COPY --from=build /repo/apps/erp/dist/ /usr/share/nginx/html/app/
COPY --from=build /repo/apps/admin/dist/ /usr/share/nginx/html/admin/

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]