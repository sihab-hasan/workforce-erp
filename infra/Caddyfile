:80 {
	route {
		@health path /healthz
		handle @health {
			respond "ok" 200
		}

		@backend path /api /api/* /sanctum /sanctum/*
		handle @backend {
			reverse_proxy api:80
		}

		@erp-root path /erp
		redir @erp-root /erp/ 308
		handle_path /erp/* {
			root * /srv/erp
			try_files {path} /index.html
			file_server
		}

		@admin-root path /admin
		redir @admin-root /admin/ 308
		handle_path /admin/* {
			root * /srv/admin
			try_files {path} /index.html
			file_server
		}

		handle {
			root * /srv/web
			try_files {path} /index.html
			file_server
		}
	}
}
