APP_NAME="Workforce ERP API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
TRUSTED_HOSTS=localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=workforce_erp_db
DB_USERNAME=workforce_erp
DB_PASSWORD=

# Broadcasting is dormant by default. Uncomment BROADCAST_CONNECTION after
# installing the driver package to push notifications to the browser live.
# BROADCAST_CONNECTION=reverb
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
# Local development uses file sessions so auth does not depend on the DB session table.
# Production/staging may override this with database or redis.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SERIALIZATION=json
# true in staging/production behind HTTPS
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
# For subdomains in production, e.g. .example.com
SESSION_DOMAIN=

MEMCACHED_HOST=localhost

REDIS_HOST=localhost
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-google-account@gmail.com
MAIL_PASSWORD=your-google-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="your-google-account@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# Laravel Reverb (self-hosted websockets). Install with:
#   composer require laravel/reverb
#   php artisan reverb:install
# then run `php artisan reverb:start` and set BROADCAST_CONNECTION=reverb.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Portal / SSO
PORTAL_URL=http://localhost:5173/erp/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/erp/sso/callback/google
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Use common for multi-tenant + personal Microsoft accounts, or your Directory (tenant) ID for single-tenant.
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:5173/erp/sso/callback/microsoft

SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:5173

# Browser CORS allowlist (comma-separated). Set production frontend origins explicitly.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional Sanctum bearer-token lifetime in minutes. Blank keeps Laravel's non-expiring default.
SANCTUM_TOKEN_EXPIRATION=480
SANCTUM_TOKEN_PREFIX=workforce_

# Local-only bootstrap user created by: php artisan db:seed
LOCAL_BOOTSTRAP_ENABLED=false
LOCAL_BOOTSTRAP_ORGANIZATION_NAME="Workforce Local"
LOCAL_BOOTSTRAP_ORGANIZATION_SLUG=workforce-local
LOCAL_BOOTSTRAP_OWNER_NAME="Local Owner"
LOCAL_BOOTSTRAP_OWNER_EMAIL=owner@workforce.local
LOCAL_BOOTSTRAP_OWNER_PASSWORD=

HASH_DRIVER=bcrypt

# Production SMS verification: set SMS_DRIVER=http with a real HTTPS provider endpoint.
SMS_DRIVER=
SMS_HTTP_ENDPOINT=
SMS_HTTP_TOKEN=
SMS_SENDER=WorkforceERP
