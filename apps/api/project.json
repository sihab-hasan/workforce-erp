{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@workforce-erp/api",
  "projectType": "application",
  "sourceRoot": "apps/api/app",
  "tags": ["type:app", "platform:php", "scope:api"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api",
        "command": "php artisan serve --host=127.0.0.1 --port=8000"
      }
    },
    "validate": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "apps/api",
        "command": "composer validate --strict --no-check-publish"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "apps/api",
        "command": "composer pint -- --test"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "apps/api",
        "command": "php artisan test"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/api",
        "parallel": false,
        "commands": [
          "composer validate --strict --no-check-publish",
          "composer pint -- --test",
          "php artisan test"
        ]
      }
    }
  }
}
