{
  "extends": "@workforce-erp/typescript-config/react-app.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "#app/*": ["src/app/*"],
      "#routes/*": ["src/routes/*"],
      "#pages/*": ["src/pages/*"],
      "#features/*": ["src/features/*"],
      "#components/*": ["src/components/*"],
      "#layouts/*": ["src/layouts/*"],
      "#lib/*": ["src/lib/*"],
      "#access/*": ["src/access/*"],
      "#config/*": ["src/config/*"],
      "#hooks/*": ["src/hooks/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
